#!/bin/sh
# Bashan OS — hold the splash briefly. It no longer plays anything.
#
# The song used to play here, at boot, through bare ALSA with aplay. On
# real hardware it played nothing at all while the desktop's own sound
# worked: bare ALSA takes the first card it finds, which on a laptop with
# HDMI audio is often an HDMI output with nothing plugged into it, and
# aplay reports success either way, so the failure was silent.
#
# The song now plays inside the user session through PipeWire, which uses
# whatever output the desktop uses. See
# /usr/libexec/bashan/bashan-session-sound.
#
# What is left is the splash hold, which is about how boot LOOKS: it waits
# only the REMAINDER up to HOLD seconds of uptime, so on a normal boot -
# which already takes longer than that - it waits for nothing at all.
set -u

CONF=/etc/bashan/boot-sound.conf
HOLD=5.5
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo "$HOLD")
sleep "$(awk -v u="$up" -v h="$HOLD" 'BEGIN { r = h - u; if (r < 0) r = 0; printf "%.2f", r }')"
exit 0
