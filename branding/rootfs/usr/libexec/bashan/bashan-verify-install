#!/bin/sh
# Bashan OS — check the installed system before handing it over.
#
# WHAT BLOCKS AND WHAT DOES NOT
#
# This only fails the install for faults that leave a machine unusable:
# no bootloader, no kernel, no greeter, no desktop session, no user
# account, or a broken fstab/EFI. Everything else - packages that differ
# from the live image, libraries apt tidied away - is a WARNING in the log
# and never stops an install.
#
# That rule was learned the hard way. An earlier version failed a correct
# install because six packages had gone:
#
#   W: fonts-quicksand libyaml-cpp0.8 live-boot-doc
#   W: live-config-doc live-tools user-setup
#   E: 6 unexplained removals exceeds the tolerance of 5
#
# Every one was legitimate - apt autoremoving calamares' own dependencies
# and the live-* packages - and the desktop was perfectly fine. The person
# installing would have seen "Installation Failed" and had no way forward.
# A check that stops a working install is worse than no check at all.
set -eu

ROOT="${BASHAN_VERIFY_ROOT:-}"
crit=0
err()  { echo "E: $*" >&2; crit=1; }
warn() { echo "W: $*" >&2; }

# ---- CRITICAL: can this machine start at all? --------------------------

# A kernel to boot.
if [ -z "$(find "$ROOT/boot" -maxdepth 1 -name 'vmlinuz-*' 2>/dev/null)" ]; then
    err "no kernel in /boot - this machine cannot start"
fi

# Something to boot it with. Either an EFI bootloader or a BIOS grub.
if [ -d "$ROOT/boot/efi/EFI" ]; then
    if [ -z "$(find "$ROOT/boot/efi/EFI" -iname '*.efi' 2>/dev/null)" ]; then
        err "/boot/efi/EFI holds no bootloader - this machine cannot start"
    fi
elif [ ! -f "$ROOT/boot/grub/grub.cfg" ]; then
    err "no EFI bootloader and no /boot/grub/grub.cfg - this machine cannot start"
fi

# An fstab that names a root filesystem.
if [ ! -s "$ROOT/etc/fstab" ]; then
    err "/etc/fstab is missing or empty"
elif ! awk '$1 !~ /^#/ && $2 == "/" {found=1} END {exit !found}' "$ROOT/etc/fstab"; then
    err "/etc/fstab has no root filesystem entry"
fi

# A greeter to log in at.
[ -x "$ROOT/usr/bin/sddm" ] || err "sddm is missing - there is no login screen"

# A desktop to log in to.
sessions=$(find "$ROOT/usr/share/xsessions" "$ROOT/usr/share/wayland-sessions" \
                -maxdepth 1 -name '*.desktop' 2>/dev/null | wc -l)
[ "$sessions" -gt 0 ] || err "no desktop session installed - nobody could log in"

# An account to log in as.
if [ -r "$ROOT/etc/passwd" ]; then
    if ! awk -F: '$3 >= 1000 && $3 < 65534 && $7 !~ /(nologin|false)$/ {found=1} END {exit !found}' \
         "$ROOT/etc/passwd"; then
        err "no ordinary user account exists - nobody could log in"
    fi
else
    err "/etc/passwd is unreadable"
fi

# ---- WARNINGS: worth knowing, never worth blocking ---------------------

MANIFEST="$ROOT/usr/share/bashan/live-packages.txt"
EXPECTED="$ROOT/usr/share/bashan/expected-removals.txt"
if [ -s "$MANIFEST" ]; then
    installed=$(mktemp); missing=$(mktemp)
    if [ -n "$ROOT" ]; then
        sort -u "$ROOT/installed-packages.txt" > "$installed"
    else
        dpkg-query -W -f='${binary:Package}\n' | sed 's/:.*//' | sort -u > "$installed"
    fi
    comm -23 "$MANIFEST" "$installed" | grep -vxF -f "$EXPECTED" > "$missing" 2>/dev/null || true
    n=$(wc -l < "$missing")
    if [ "$n" -gt 0 ]; then
        warn "$n package(s) from the live image are not installed:"
        sed 's/^/W:   /' "$missing" >&2
        warn "this is information only and does not stop the install"
    fi
    rm -f "$installed" "$missing"
else
    warn "$MANIFEST missing; cannot compare packages"
fi

grep -q '^Autolock=false' "$ROOT/etc/xdg/kscreenlockerrc" 2>/dev/null \
    && warn "the screen will not lock automatically on this installed system"
grep -q '^Enabled=false' "$ROOT/etc/xdg/kwalletrc" 2>/dev/null \
    && warn "KWallet is disabled; Brave will store passwords less securely"
[ -e "$ROOT/lib/live/config/2000-bashan-live" ] \
    && warn "live-only configuration is still present at /lib/live/config"
[ -e "$ROOT/etc/systemd/system/multi-user.target.wants/unattended-upgrades.service" ] \
    || warn "security updates are not enabled"

[ "$crit" = 0 ] || { echo "E: the installed system would not start; refusing to continue" >&2; exit 1; }
echo "I: installed system verified - it has a kernel, a bootloader, a login screen,"
echo "I: a desktop session and a user account"
