#!/bin/sh
# Bashan OS — assert the installed system can actually be logged into.
#
# Runs chrooted into the target, AFTER the packages job.
#
# Install attempt 4 finished with "All done." and produced a system that
# booted to SDDM with an EMPTY session dropdown and no way in. Cause: the
# packages job did a hard `apt remove qml6-module-qtquick-controls` to tidy
# up after Calamares. apt removes every reverse-dependency too, and Plasma 6
# depends on it, so the entire desktop was uninstalled:
#
#   $ ls /usr/share/xsessions/
#   ls: cannot access '/usr/share/xsessions/': No such file or directory
#   $ dpkg -l plasma-desktop
#   un  plasma-desktop  <none>  <none>
#
# The root cause is fixed in packages.conf. This exists so that if a future
# package change does it again, the installer FAILS here with a clear reason
# instead of handing over a machine nobody can log into.
set -eu

found=$(find /usr/share/xsessions /usr/share/wayland-sessions \
             -maxdepth 1 -name '*.desktop' 2>/dev/null | wc -l)
if [ "$found" -eq 0 ]; then
    echo "E: no desktop session installed - nobody could log in to this system" >&2
    echo "E: /usr/share/xsessions and /usr/share/wayland-sessions are empty or absent" >&2
    echo "E: check the remove list in the packages module for a cascading removal" >&2
    exit 1
fi
echo "I: $found desktop session(s) installed"

# The greeter has to exist too, or the machine boots to a blank screen.
if [ ! -x /usr/bin/sddm ]; then
    echo "E: sddm is missing; the installed system has no login screen" >&2
    exit 1
fi
echo "I: sddm present"
