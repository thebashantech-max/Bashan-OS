#!/bin/sh
# Bashan OS — install Google Chrome on demand, for a non-technical user.
# Asks first, shows progress, and explains any failure in plain words.
set -u

# --- translations -------------------------------------------------------
# Catalogues are generated from i18n/strings.json by scripts/40-i18n.py.
# Fall back to English for any language we do not ship, and for any string
# a catalogue is missing.
I18N_DIR=/usr/share/bashan/i18n
# shellcheck source=/dev/null
[ -r "$I18N_DIR/en.sh" ] && . "$I18N_DIR/en.sh"
_lang=${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}
_lang=${_lang%%.*}
_lang=${_lang%%@*}
if [ -r "$I18N_DIR/$_lang.sh" ]; then
    # shellcheck source=/dev/null
    . "$I18N_DIR/$_lang.sh"
elif [ -r "$I18N_DIR/${_lang%%_*}.sh" ]; then
    # shellcheck source=/dev/null
    . "$I18N_DIR/${_lang%%_*}.sh"
fi

TITLE="${BT_CHROME_TITLE:-Install Google Chrome}"

if command -v kdialog >/dev/null 2>&1; then
    ask()  { kdialog --title "$TITLE" --yesno "$1"; }
    note() { kdialog --title "$TITLE" --msgbox "$1"; }
    oops() { kdialog --title "$TITLE" --error "$1"; }
    busy() { kdialog --title "$TITLE" --passivepopup "$1" 20 >/dev/null 2>&1; }
else
    ask()  { return 0; }
    note() { echo "$1"; }
    oops() { echo "$1" >&2; }
    busy() { echo "$1"; }
fi

if [ -x /usr/bin/google-chrome-stable ]; then
    note "$BT_CHROME_ALREADY"
    exec /usr/bin/google-chrome-stable
fi

ask "$BT_CHROME_ASK" || exit 0

busy "$BT_CHROME_BUSY"

err=$(pkexec /usr/libexec/bashan/chrome-install 2>&1)
rc=$?

if [ "$rc" -eq 0 ] && [ -x /usr/bin/google-chrome-stable ]; then
    note "$BT_CHROME_OK"
    exec /usr/bin/google-chrome-stable
fi

case "$rc" in
    126|127) oops "$BT_CHROME_CANCELLED" ;;
    *)       oops "$BT_CHROME_FAILED

$err" ;;
esac
exit 1
