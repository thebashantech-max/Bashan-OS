#!/bin/sh
# Bashan OS — install Inkscape on request.
#
# Inkscape is NOT in the image. It is 108 MB of its own plus a GTK stack
# nothing else here needs, which together would push the ISO past the size
# budget for a USB stick that is already slow to read. It is offered as a
# download instead, the same way Google Chrome is.
#
# It comes from Debian's own archive, which is already configured and
# already trusted by the system - nothing new is added to the sources.
set -u

ASK="Inkscape is for drawing icons, logos and other artwork.

It is about 108 MB and will be downloaded from Debian.
This needs an internet connection.

Install it now?"

if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "Get Inkscape" --yesno "$ASK" || exit 0
else
    printf '%s\n\nContinue? [y/N] ' "$ASK"
    read -r reply
    case "$reply" in y|Y|yes|YES) ;; *) exit 0 ;; esac
fi

exec pkexec sh -c 'apt-get update && apt-get install -y --no-install-recommends inkscape'
