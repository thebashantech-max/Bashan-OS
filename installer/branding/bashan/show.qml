    readonly property string lang: {
        var n = Qt.locale().name.split("_")[0];
        return tr.hasOwnProperty(n) ? n : "en";
    }
    function t(key) { return tr[lang][key] || tr["en"][key]; }
    function nextSlide() {
        presentation.goToNextSlide();
    }

    Timer {
        id: advanceTimer
        interval: 9000
        running: presentation.activatedInCalamares
        repeat: true
        onTriggered: nextSlide()
    }

    Slide {
        Image {
            id: bg1
            source: "slide-bg.png"
            anchors.fill: parent
            fillMode: Image.PreserveAspectCrop
        }
        Column {
            anchors.centerIn: parent
            spacing: 18
            width: parent.width * 0.8
            Text {
                text: presentation.t("slide1.title")
                color: "#e6f0fa"
                font.pixelSize: 40
                anchors.horizontalCenter: parent.horizontalCenter
            }
            Text {
                text: presentation.t("slide1.body")
                color: "#8aa0bd"
                font.pixelSize: 20
                wrapMode: Text.WordWrap
                horizontalAlignment: Text.AlignHCenter
                width: parent.width
            }
        }
    }

