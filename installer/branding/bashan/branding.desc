# Bashan OS installer branding. Publisher: Bashan Tech LLC.
---
componentName: bashan

welcomeStyleCalamares: false
welcomeExpandingLogo:  true

windowExpanding: normal
windowSize:      920px,620px
windowPlacement: center

strings:
    productName:            "Bashan OS"
    shortProductName:       "Bashan"
    version:                "1.0"
    shortVersion:           "1.0"
    versionedName:          "Bashan OS 1.0"
    shortVersionedName:     "Bashan 1.0"
    bootloaderEntryName:    "Bashan OS"
    productUrl:             "https://bashan.app"
    supportUrl:             "https://bashan.app"
    knownIssuesUrl:         "https://bashan.app"
    releaseNotesUrl:        "https://bashan.app"
    donateUrl:              ""

images:
    productBanner:  "banner.png"
    productIcon:    "logo.png"
    productLogo:    "logo.png"
    productWelcome: "welcome.png"

slideshow:            "show.qml"
slideshowAPI:         2

# Calamares accepts EXACTLY four style keys. Three of the names used here
# before were invented and silently ignored - the install log said
# "Unknown branding *style* entry" for each - so the current-step
# highlight was never actually styled. Checked against the strings in
# libcalamaresui: SidebarBackground, SidebarBackgroundCurrent,
# SidebarText, SidebarTextCurrent.
style:
   SidebarBackground:         "#0b1018"
   SidebarText:               "#8aa0bd"
   SidebarBackgroundCurrent:  "#0e737b"
   SidebarTextCurrent:        "#e6f0fa"
