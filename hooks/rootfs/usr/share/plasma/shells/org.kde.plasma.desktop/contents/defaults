# Bashan OS — use the Desktop containment, not Folder View.
#
# WHY THIS FILE EXISTS
#
# Plasma 6 defaults the desktop to org.kde.plasma.folder (Folder View).
# Folder View does not use ContainmentLayoutManager.AppletsLayout at all -
# verified by grepping its QML - so desktop widgets on it have no position
# system: `widget.geometry = ...` is accepted and silently ignored, and the
# ItemGeometries keys are never written. That is the whole reason the Trash
# icon and the weather and notes widgets never appeared where they were
# told to, from Stage 9 through Part G.
#
# org.kde.desktopcontainment DOES use AppletsLayout, with
# configKey "ItemGeometries-<width>x<height>".
#
# There is no supported way to choose the containment from a look-and-feel
# package, and the scripting API refuses it outright:
#   TypeError: Cannot assign to read-only property "type"
# so this is the remaining lever.
#
# WHAT WE GIVE UP: Folder View shows the contents of ~/Desktop as icons.
# Bashan OS does not use desktop icons, so nothing is lost.
#
# FAILURE MODE IS GRACEFUL: this overrides a file from plasma-desktop. If
# an upgrade of that package ever restores Debian's version, the desktop
# reverts to Folder View and the widgets go back to being unpositioned.
# Nothing breaks. Automatic updates are security-only, so this will not
# happen on its own.
[Desktop]
Containment=org.kde.desktopcontainment
ToolBox=
RuntimePlatform=Desktop

[Desktop][ContainmentActions]
RightButton;NoModifier=org.kde.contextmenu
MiddleButton;NoModifier=org.kde.paste

[Panel]
Containment=org.kde.panel
ToolBox=org.kde.paneltoolbox
[Panel][ContainmentActions]
RightButton;NoModifier=org.kde.contextmenu
