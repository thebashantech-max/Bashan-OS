#!/bin/sh
# Bashan OS — activate the boot branding inside the image.
set -e

# Plymouth must be told which theme to use and the initramfs rebuilt, or the
# splash will not appear at all on a real boot.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme bashan
    echo "I: plymouth default theme set to bashan"
fi

if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u
    echo "I: initramfs rebuilt with the Bashan splash"
fi

# Boot sound: ordering-only unit, safe to enable.
systemctl enable bashan-boot-sound.service 2>/dev/null || true

# Plymouth on shutdown and reboot, so powering off looks like booting.
for unit in plymouth-poweroff.service plymouth-reboot.service \
            plymouth-halt.service plymouth-kexec.service; do
    systemctl enable "$unit" 2>/dev/null || true
done

echo "I: boot branding activated"

# The lock screen and SDDM show the user's avatar. Debian ships its swirl
# as the default, which appeared on the Stage 1 lock screen - a Debian logo
# in one of the most visible places there is.
if [ -f /usr/share/bashan/default-face.png ]; then
    install -D -m 0644 /usr/share/bashan/default-face.png /etc/skel/.face.icon
    for d in /home/*/; do
        [ -d "$d" ] || continue
        install -D -m 0644 /usr/share/bashan/default-face.png "$d/.face.icon" 2>/dev/null || true
    done
    echo "I: default user avatar set to the Bashan mark"
fi
