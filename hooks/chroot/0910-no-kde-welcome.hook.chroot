#!/bin/sh
# Bashan OS — remove KDE's Welcome Center.
#
# Stage 9 defect 5: plasma-welcome opened on first boot alongside our own
# welcome app. Suppressing its autostart would be guesswork about how Plasma
# triggers it; removing the package cannot be got wrong. It is a Recommends
# of plasma-desktop, not a Depends, so nothing else goes with it - verified
# with `apt-get remove -s`, which reported exactly one package removed.
set -e

if dpkg-query -W -f='${Status}' plasma-welcome 2>/dev/null | grep -q "install ok installed"; then
    echo "I: removing plasma-welcome (replaced by bashan-welcome)"
    # apt purge takes reverse-dependencies with it. That is how the installed
    # system lost every bit of Plasma: one QML module was removed by name and
    # the whole desktop went with it, while the installer still reported
    # success. Simulate first and refuse, rather than find out after shipping.
    extra=$(apt-get purge -s -y plasma-welcome 2>/dev/null \
            | awk '/^Remv /{print $2}' | grep -vx plasma-welcome || true)
    if [ -n "$extra" ]; then
        echo "E: purging plasma-welcome would also remove:" >&2
        echo "$extra" | sed 's/^/E:   /' >&2
        exit 1
    fi
    apt-get purge -y plasma-welcome
fi

if dpkg-query -W -f='${Status}' plasma-welcome 2>/dev/null | grep -q "install ok installed"; then
    echo "E: plasma-welcome is still installed" >&2
    exit 1
fi

# Our own welcome app must be there in its place.
# The last three are what page 6's buttons open. A missing file there is a
# button that does nothing, which is exactly the kind of defect that only
# shows up in front of a user.
for f in /usr/bin/bashan-welcome /usr/share/bashan/welcome/main.qml \
         /usr/share/bashan/welcome/i18n.json /usr/lib/qt6/bin/qml \
         /usr/share/doc/bashan/legal/NOTICE.md \
         /usr/share/doc/bashan/legal/TERMS.md \
         /usr/share/doc/bashan/legal/PRIVACY.md; do
    if [ ! -e "$f" ]; then
        echo "E: welcome app incomplete, missing $f" >&2
        exit 1
    fi
done

echo "I: KDE Welcome Center removed; bashan-welcome in place"
