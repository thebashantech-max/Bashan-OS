## Bashan OS — core operating system.
## Desktop, firmware, browsers, office and fonts live in Stage 4 lists.

# Kernel (stock Debian, tuned via sysctl/udev rather than a custom build)
linux-image-amd64

# Boot chain, both firmware types
grub-efi-amd64-bin
grub-pc-bin
grub2-common
efibootmgr
os-prober

# Secure Boot. Without these the machine simply refuses to boot when Secure
# Boot is on, which is the factory default on every laptop since ~2012.
# shim is the small Microsoft-signed loader the firmware will accept; it then
# loads Debian's signed GRUB, which loads the signed kernel. The stock
# linux-image-amd64 is already the signed build (source: linux-signed-amd64).
shim-signed
grub-efi-amd64-signed
mokutil

# Init and core plumbing
systemd-sysv
systemd-timesyncd
systemd-resolved
dbus-user-session
polkitd
udisks2
util-linux
# hwclock lives here, NOT in util-linux. Without it Calamares' hwclock job
# fails with "chroot: failed to run command 'hwclock'" and reports
# "BIOS or Kernel BUG: Setting hwclock failed" - found in the install log.
# Non-fatal to the install, but it means the installed system never writes
# the time back to the hardware clock.
util-linux-extra
zstd

# Compressed RAM swap
systemd-zram-generator

# Networking
network-manager
iproute2
iputils-ping
ca-certificates
curl
wget
openssh-client

# Filesystems
e2fsprogs
dosfstools
exfatprogs
ntfs-3g
btrfs-progs
xfsprogs
gdisk
parted

# Archive / package plumbing
gnupg
apt-utils

# Locale and console
locales
console-setup
keyboard-configuration
tzdata

# Minimal console tools (a usable rescue shell without a desktop)
bash-completion
less
nano
pciutils
usbutils
sudo
