## Bashan OS — fonts, one entry per script we ship.
## Covers Latin, Cyrillic, Greek, Arabic, Hebrew, Syriac and the Arabic-script
## languages (Persian, Sorani, Kurmanji where written in Arabic script).

# Broad coverage: Latin, Greek, Cyrillic, Hebrew, Arabic basics
fonts-noto-core
fonts-noto-ui-core
fonts-noto-color-emoji
fonts-dejavu

# Arabic / Persian / Kurdish — proper Naskh shaping, not a fallback box
fonts-sil-scheherazade
fonts-sil-lateef
fonts-hosny-amiri
fonts-kacst-one
fonts-farsiweb

# Hebrew
fonts-culmus

# Syriac. fonts-noto-extra carries Noto Sans Syriac under OFL-1.1.
# It was already being installed as a dependency, but Syriac now depends on
# it, so it is listed explicitly rather than left to chance.
# NOT fonts-xfree86-nonfree-syriac: see config/archives/bashan-exclusions.pref.chroot
fonts-noto-extra

# Terminal and code
fonts-jetbrains-mono
