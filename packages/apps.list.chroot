## Bashan OS — everyday applications.
## Mail/calendar/contacts is Thunderbird. No Evolution, no Kontact, and
## therefore no Akonadi.

# Mail, calendar, contacts
thunderbird

# Files, terminal, text
dolphin
konsole
kate
ark

# Viewing
okular
gwenview
kde-spectacle

# Small utilities
kcalc
kamoso

# --- Viewing / playback ------------------------------------------------
# VLC plays everything we ship codecs for and is the default for video and
# audio (see /etc/xdg/mimeapps.list). No account, no telemetry; its two
# network features (album-art lookup, update check) are switched off in
# /etc/skel/.config/vlc/vlcrc.
vlc

# --- Editors -----------------------------------------------------------
# Deliberately NOT here: krita, obs-studio, audacity. All three are in
# trixie and are one click away in Discover; keeping them out saves roughly
# 1.1 GB installed and none of them is needed for everyday use.
kolourpaint
gimp
kdenlive

# --- Converters --------------------------------------------------------
# Both resolve in trixie, so no fallback was needed.
converseen
handbrake

# NOTE on image formats: nothing is added for HEIC, AVIF, JPEG XL, WebP,
# TIFF or camera RAW. All of it is already present and costs 0 bytes, via
# kimageformat6-plugins (kimg_heif, kimg_avif, kimg_jxl, kimg_raw, ...) and
# qt6-image-formats-plugins (webp, tiff, icns), both already in
# desktop.list.chroot. Dolphin's RAW thumbnails come from
# kdegraphics-thumbnailers, also already installed.
# NOTE on codecs: gstreamer good/bad/ugly/libav are already installed and
# vlc brings vlc-plugin-base, so H.264/H.265/VP9/AV1/AAC/MP3/FLAC all play
# without libavcodec-extra. Patent questions are logged in docs/legal/.

# --- the welcome app ---------------------------------------------------
# "Get to Know Bashan OS" is plain QML run by the `qml` runner, which lives
# in qml-qt6 and NOT in qt6-declarative-dev-tools (that ships qmllint,
# qmlformat and friends, but no runtime). Everything else the app imports -
# QtQuick, Controls, Layouts, QtCore, QtMultimedia - was already in the
# image for Calamares and Plasma, so the entire application costs 0.1 MB.
# PySide6 would have cost 86.4 MB and PyQt6 17.9 MB for the same thing.
qml-qt6

# --- Learn to Code -------------------------------------------------------
# Free software, no account, no sign-up, nothing that contacts the internet
# on its own. Sizes below are each package's own Installed-Size;
# dependencies are extra and show up as the ISO delta.
#
# There is NO Scratch-style block-programming tool in Debian 13. scratch,
# scratch3, turtleart, blockly and snap-gui are all absent from the archive,
# so none is shipped and none is pretended at. KTurtle is the closest
# teaching language that actually exists here.
#
#   thonny            7.9 MB   Python for beginners, GPL-3
#   kturtle           6.0 MB   Logo-style teaching language, GPL-2
#   geany             4.8 MB   small code editor, GPL-2
#   idle-python3.13   1.9 MB   the editor that ships with Python, PSF
#   gcompris-qt-data   77 MB   AGPL-3, activities for young children
thonny
kturtle
geany
idle-python3.13
python3-tk
gcompris-qt
gcompris-qt-data

# --- Graphics ------------------------------------------------------------
# Krita reuses the Qt and KF6 libraries Plasma already pulls in, so its
# dependency cost is small. Inkscape is NOT shipped: 108 MB plus a GTK stack
# nothing else needs puts it over the size cap, so it is offered as a
# download instead, the same way Chrome is.
#
#   krita              88 MB   digital painting and icon work, GPL-3
krita

# --- Chinese input -------------------------------------------------------
# Chinese cannot be a keyboard layout. The keyboard stack allows four
# layouts at once and Chinese needs an input method, not a layout. Pinyin
# runs on top of whichever layout is active, so it costs no layout slot.
# fonts-noto-cjk is already in fonts.list.chroot.
#
#   ibus-libpinyin    2.6 MB   Pinyin input method, LGPL-2.1
ibus-libpinyin
