# Bashan OS — packages that must never be installed.
#
# Pinned rather than merely purged: every one of these arrived through a
# Recommends rather than through packages/*.list.chroot, so purging alone
# would let the next dependency resolution bring them straight back.
# Priority -1 means apt will not install them even to satisfy a Recommends.
#
# Verified before pinning: nothing in the image Depends on any of them
# (`apt-cache rdepends --installed` reported no reverse dependencies), so
# this cannot break a dependency chain.

# These three DOWNLOAD Broadcom firmware from the internet at install time
# rather than containing it. The target is a laptop installed from USB with
# no network, where they simply fail; and they fetch material whose terms we
# have not reviewed. packages/firmware.list.chroot already said they were
# excluded - they were not.
Package: firmware-b43-installer
Pin: release *
Pin-Priority: -1

Package: firmware-b43legacy-installer
Pin: release *
Pin-Priority: -1

Package: b43-fwcutter
Pin: release *
Pin-Priority: -1

# Non-free astronomy camera libraries. Nothing uses them.
Package: libfishcamp1t64
Pin: release *
Pin-Priority: -1

Package: libsbig4t64
Pin: release *
Pin-Priority: -1

# The Meltho Syriac fonts. Their licence permits redistribution but forbids
# modification, which is why Debian classes them non-free. Noto Sans Syriac
# (fonts-noto-extra, OFL-1.1) covers the same script and is unambiguously
# free, so the non-free package buys nothing but a legal question.
Package: fonts-xfree86-nonfree-syriac
Pin: release *
Pin-Priority: -1

# --- approved trims, 2026-10-13 -----------------------------------------

# 209.8 MB. The extra CJK weights. None of the 13 shipped languages is
# Chinese, Japanese or Korean. fonts-noto-cjk (89.1 MB) is KEPT so that CJK
# text on a web page still renders as characters rather than empty boxes.
# Verified a Recommends of fonts-noto / fonts-noto-cjk, not a Depends:
# `apt-get remove -s` reported exactly one package removed.
Package: fonts-noto-cjk-extra
Pin: release *
Pin-Priority: -1

# 0.4 MB, but it is a LISTENING DAEMON for discovering remote CUPS print
# servers, and the component behind the 2024 remote-code-execution family.
# Modern printers are found by driverless IPP through avahi, which stays.
# The saving is attack surface, not disk. A Recommends of cups-daemon.
Package: cups-browsed
Pin: release *
Pin-Priority: -1

# 4.6 MB plus a background service. Owner confirmed the target laptop has no
# SIM slot, and ModemManager exists only to drive cellular modems. A
# Recommends of network-manager, so removing it does not touch networking.
Package: modemmanager
Pin: release *
Pin-Priority: -1
